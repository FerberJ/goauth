package layouts

import "github.com/FerberJ/goauth/frontend/components"
import "github.com/FerberJ/goauth/frontend/middleware/pattern"

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href={ getStyleCss(pattern.GetPattern(ctx)) }/>
			<script src="/auth/_/assets/htmx.min.js"></script>
			@components.Scripts()
		</head>
		<body>
			{ children... }
		</body>
		<script>
			function getLogin() {
				htmx.ajax('GET', '/auth/_/login', { target: '#root', swap: 'innerHTML' });
			}

			document.body.addEventListener('htmx:responseError', function (evt) {
				if (evt.detail.xhr.status !== 401) return;

				// If this request was already a retry attempt, stop here — go to login instead
				if (evt.detail.requestConfig.headers && evt.detail.requestConfig.headers['X-Retried']) {
					getLogin()
					return;
				}

				evt.preventDefault(); // stop htmx from swapping the error response

				fetch('/auth/refresh', {
					method: 'POST',
					credentials: 'include',
				})
					.then(res => {
						if (!res.ok) throw new Error('refresh failed');
					})
					.then(() => {
						// retry the original request, tagged so we know it's a retry
						htmx.ajax(evt.detail.requestConfig.verb, evt.detail.requestConfig.path, {
							source: evt.detail.requestConfig.elt,
							headers: { 'X-Retried': 'true' },
						});
					})
					.catch(() => {
						getLogin()
					});
			});
		</script>
	</html>
}

func getStyleCss(pattern string) string {
	return pattern + "/_/assets/css/styles.css"
}
